# Vorlage für die .env auf dem Server:  cp .env.example .env
# Die .env enthält persönliche Daten und wird NICHT ins Git-Repository übernommen.
#
# Werte mit einem $-Zeichen (Passwort-Hash, Passwörter) in 'einfache Anführungszeichen' setzen,
# sonst versucht Docker Compose, sie als Variablen aufzulösen.

# Domain, unter der Traefik die App ausliefert (ohne https://)
EVC_DOMAIN=evchecker.example.org

# Zugangsschutz (Traefik BasicAuth): Benutzer + Passwort-Hash
# Hash erzeugen, z. B.:  docker run --rm httpd:2.4-alpine htpasswd -nbB meinname 'MeinPasswort'
# Ausgabe (meinname:$2y$05$...) komplett in einfache Anführungszeichen setzen:
EVC_BASIC_AUTH='meinname:$2y$05$ErsetzenDurchDenEchtenHash'

# E-Mail-Versand (optional – ohne SMTP_HOST ist die tägliche Mail nicht nutzbar)
EVC_SMTP_HOST=
EVC_SMTP_PORT=587
# starttls (meist Port 587) | ssl (meist Port 465) | none
EVC_SMTP_SECURITY=starttls
EVC_SMTP_USER=
EVC_SMTP_PASSWORD=''
# Absenderadresse (leer = EVC_SMTP_USER)
EVC_SMTP_FROM=

# Datensicherung der Datenbank nach ./data/backups
EVC_BACKUP_TIME=03:00
EVC_BACKUP_KEEP=14
